# Deployer account private key (0x-prefixed hex, 64 hex chars). Use a throwaway key that only
# ever holds testnet MON; never a mainnet key, and never commit the real .env file.
# Generate one with:
#   node -e "import('viem/accounts').then(a=>{const k=a.generatePrivateKey();console.log(k, a.privateKeyToAccount(k).address)})"
# Fund the printed address at https://faucet.monad.xyz, then: npm run check:deployer
DEPLOYER_PRIVATE_KEY=

# Monad testnet RPC endpoint (chainId 10143). Public default below; a QuickNode/Alchemy/Ankr
# endpoint avoids rate limits on the public one.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Both values above are copied into web/.env by `npm run wire:env` after `npm run deploy:monad`.

# --- Cleanverse simulator + FukuSpendGuard ------------------------------------------------
# Address FukuSpendGuard trusts to sign GuardedTransfer (EIP-712) attestations. Read by
# scripts/deploy.ts and scripts/deploy-cleanverse.ts. Leave empty and the deployer address
# is used instead (with a loud warning); prefer a dedicated key that is NOT the deployer.
# Rotate later with FukuSpendGuard.setComplianceSigner(address) from the owner account.
# Local node convention: Hardhat account #1, 0x70997970C51812dc3A010C7d01b50e0d17dc79C8.
COMPLIANCE_SIGNER_ADDRESS=

# Private key of that compliance signer (0x + 64 hex). No deploy script uses it; `npm run
# wire:env` copies it into web/.env so the web app can sign attestations, and warns when it
# does not match the deployment's "complianceSigner". Testnet-only throwaway key.
FUKU_COMPLIANCE_SIGNER_KEY=
