# Deployer account private key (0x-prefixed hex, 64 hex chars). Use a throwaway key that only
# ever holds testnet MON; never a mainnet key, and never commit the real .env file.
# Generate one with:
#   node -e "import('viem/accounts').then(a=>{const k=a.generatePrivateKey();console.log(k, a.privateKeyToAccount(k).address)})"
# Fund the printed address at https://faucet.monad.xyz, then: npm run check:deployer
DEPLOYER_PRIVATE_KEY=

# Monad testnet RPC endpoint (chainId 10143). Public default below; a QuickNode/Alchemy/Ankr
# endpoint avoids rate limits on the public one.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Both values above are copied into web/.env by `npm run wire:env` after `npm run deploy:monad`.
