# --- Core ---------------------------------------------------------------
# SQLite for local dev. For Supabase/Postgres: change the provider in prisma/schema.prisma
# to "postgresql" and point this at your connection string.
DATABASE_URL="file:./dev.db"
# Required in production: at least 32 random characters (the server refuses the default there).
FUKU_SESSION_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# WebAuthn: origins allowed to run passkey ceremonies (comma separated; defaults to
# NEXT_PUBLIC_APP_URL; http://localhost:* is also accepted outside production) and the RP id.
# WEBAUTHN_ORIGINS=https://fuku.example.com
# WEBAUTHN_RP_ID=fuku.example.com
# The seeded demo (Ava Chen, the demo key, /api/auth/demo) is on in development and off in
# production unless this is "true" (only for an isolated demo deployment).
# FUKU_DEMO_ENABLED=true
# Reconciliation (npm run reconcile): blocks re-checked for reorgs, and how far back to look for
# a guarded transfer whose hash was never stored.
# FUKU_REORG_DEPTH=64
# FUKU_LOG_LOOKBACK=20000

# --- Monad settlement -----------------------------------------------------
# mock (default): proof hashes computed locally, receipts mocked.
# live: sign real transactions against the deployed contracts (see /contracts).
#       Requires DEPLOYER_PRIVATE_KEY and the four FUKU_*_REGISTRY addresses; the signer must be
#       the account that deployed the registries (it is the registry owner, enforcer and scorer).
#       Identities/agents created in mock mode are anchored lazily on their first live write.
FUKU_CHAIN_MODE=mock
# Chain parameters (defaults are Monad testnet). Point them at a local Hardhat node to rehearse:
#   npx hardhat node  ->  FUKU_CHAIN_ID=31337 FUKU_CHAIN_NAME="Hardhat local" MONAD_RPC_URL=http://127.0.0.1:8545
# FUKU_CHAIN_ID=10143
# FUKU_CHAIN_NAME="Monad Testnet"
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# FUKU_EXPLORER_URL=https://testnet.monadexplorer.com
# DEPLOYER_PRIVATE_KEY=0x...
# Addresses from contracts/deployments/<network>.json after `npm run deploy:monad`.
# FUKU_IDENTITY_REGISTRY=0x...
# FUKU_AGENT_REGISTRY=0x...
# FUKU_PERMISSION_REGISTRY=0x...
# FUKU_REPUTATION_REGISTRY=0x...

# --- AI reasoning (OpenAI-compatible; falls back to the rule narrator when unset) ---
# KIMI_API_KEY=            # Moonshot
# KIMI_MODEL=kimi-k2-0905-preview
# QWEN_API_KEY=            # DashScope
# QWEN_MODEL=qwen-plus

# --- Sponsor integrations (each flips its card from "simulated" to "live") ---
# NEXT_PUBLIC_DYNAMIC_ENV_ID=
# NANSEN_API_KEY=            # api.nansen.ai; GET /account is free, address labels cost 100 credits per lookup
# NANSEN_CHAIN=monad         # chain used for wallet labels (monad, ethereum, base, ...)
# ENVIO_API_TOKEN=           # HyperSync token: indexes the Fuku registries (Activity -> On-chain)
# ENVIO_HYPERRPC_TOKEN=      # HyperRPC token: verifies a decision's proof hash on-chain
# ENVIO_START_BLOCK=65257400 # first block of the Fuku registries (Monad testnet deployment)
# CRE_WORKFLOW_ID=

# --- Cleanverse CVI / CVA (see docs/CLEANVERSE.md) -------------------------------------
# Live mode: cooperate API credentials (invite-only). The key is base64 (16/24/32 bytes).
# CLEANVERSE_API_ID=
# CLEANVERSE_API_KEY=
# CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
# CLEANVERSE_CHAIN=monad             # chain id string sent to the API (unverified for Monad testnet)
# CLEANVERSE_MODE=                   # "sim" forces the simulator, "off" switches Cleanverse off
# CLEANVERSE_REQUEST_TIMEOUT_MS=8000
# CLEANVERSE_ATOKEN_SYMBOL=aUSDC     # a known A-Token, checked before query_deposit_atoken_list
# CLEANVERSE_ATOKEN_ADDRESS=0x...
# Simulator + guard (written by `npm run wire:env` after a deploy that includes them):
# CLEANVERSE_SIM_APASS=0x...
# CLEANVERSE_SIM_ATOKEN=0x...
# FUKU_SPEND_GUARD=0x...
# Signs GuardedTransfer attestations; must be the guard's complianceSigner. Use a dedicated key.
# FUKU_COMPLIANCE_SIGNER_KEY=0x...
# Ava's funding wallet for the demo (testnet only). Create one with:
#   node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
# DEMO_OWNER_PRIVATE_KEY=0x...

# --- Agent keys and ERC-8004 --------------------------------------------------------------
# Each agent gets its own key (its ERC-8004 agentWallet), sealed with AES-256-GCM under this secret.
# At least 32 random characters; changing it makes existing agent keys unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FUKU_AGENT_KEY_SECRET=
# Public base URL of agent registration files (agentURI); defaults to NEXT_PUBLIC_APP_URL.
# FUKU_ERC8004_URI_BASE=https://fuku.example
