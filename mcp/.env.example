# Fuku MCP server. `npm run mcp:setup` writes the real values to mcp/.env (gitignored).
# The server reads mcp/.env itself; an MCP client's env block overrides any of these.
FUKU_BASE_URL=http://localhost:3001
# An agent key for FUKU_AGENT_ID (fk_agent_…), minted by mcp:setup. An owner key (fk_live_…) is refused
# unless FUKU_MCP_ALLOW_OWNER_KEY=1.
FUKU_API_KEY=<from npm run mcp:setup>
FUKU_AGENT_ID=fuku:agent:0x<40 hex digits>
# The agent's own key (32 bytes hex). Leave it out to run read-only.
FUKU_AGENT_PRIVATE_KEY=<from npm run mcp:setup>
